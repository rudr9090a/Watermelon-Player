# Watermelon frontend — environment configuration
# Copy this file to `.env.local` for local development.

# Server-only origin of the private FastAPI backend.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# Cookie `Secure` flag. Defaults to true in production and false in development.
# If you run the production build over plain HTTP (for example on a home LAN),
# set this to false or the browser will not store the session cookie.
COOKIE_SECURE=false
